#!/usr/bin/env python3
"""Memory-aware compiler launcher.

Usage as a prefix:  ramsched <compiler> <args...>
Report:             ramsched --report

Each compile reserves an estimate (recent peak + margin) before it starts, and is
admitted only while its reservation fits. Two limits can apply, separately or together:

  budget    compiles hold at most this much in total
  headroom  this much memory stays available on the machine, whoever uses the rest

While a compile runs its memory is polled. At its reservation it grows if the limits
allow, otherwise it is SIGSTOPped until they do. If available memory falls below the
pause level, or macOS reports memory pressure (warn), all but the oldest compile are paused;
below the kill level, or at critical pressure, the newest are killed and requeued. If every compile holding memory is paused, the one that has run the
shortest is killed and requeued with a larger reservation.

Any internal failure falls back to running the compiler directly.

Environment (sizes in GB):
  RAMSCHED              "off" runs the compiler directly
  RAMSCHED_BUDGET       total compiles may reserve (default: no budget)
  RAMSCHED_HEADROOM     memory kept available, or "off" (default: 10% of RAM)
  RAMSCHED_PAUSE_BELOW  available memory below which compiles are paused (default: headroom / 2)
  RAMSCHED_KILL_BELOW   available memory below which compiles are killed, or "off"
                        (default: headroom / 4)
  RAMSCHED_DEFAULT      reservation for a command with no history (default 2 for C++, 0.5 otherwise)
  RAMSCHED_DIR          ledger directory, live builds only (default $XDG_RUNTIME_DIR/ramsched,
                        else /tmp/ramsched-<uid>); must be owned by the user and private
  RAMSCHED_HISTORY      peak history file (default ~/.cache/ramsched/history.json)
"""

import ctypes
import errno
import fcntl
import hashlib
import json
import os
import signal
import subprocess
import sys
import time

GB = 1 << 30
MB = 1 << 20
MARGIN = 1.15
GROW_MINIMUM = 256 * MB
POLL_SECONDS = 0.1
WAIT_SECONDS = 0.2
PUBLISH_SECONDS = 1.0
PUBLISH_BYTES = 64 * MB
PROTECT_AFTER_SECONDS = 30.0
KILL_INTERVAL_SECONDS = 2.0
LOCK_TIMEOUT_SECONDS = 10.0
HISTORY_DEPTH = 3
DEFAULT_ESTIMATE = {'c': 512 * MB, 'cpp': 2 * GB}

STATE_DIRECTORY = os.environ.get('RAMSCHED_DIR') or (
    os.path.join(os.environ['XDG_RUNTIME_DIR'], 'ramsched') if os.environ.get('XDG_RUNTIME_DIR')
    else f'/tmp/ramsched-{os.getuid()}')
LEDGER_PATH = os.path.join(STATE_DIRECTORY, 'ledger.json')
HISTORY_PATH = os.environ.get('RAMSCHED_HISTORY',
                              os.path.expanduser('~/.cache/ramsched/history.json'))
LOCK_PATH = os.path.join(STATE_DIRECTORY, 'lock')
EVENTS_PATH = os.path.join(STATE_DIRECTORY, 'events.log')

HOLDING = ('running', 'paused')


class LockTimeout(Exception):
    pass


class UnsafeStateDirectory(Exception):
    pass


def prepare_state_directory():
    """The ledger names process groups to kill, so only this user may write it."""
    os.makedirs(STATE_DIRECTORY, mode=0o700, exist_ok=True)
    status = os.lstat(STATE_DIRECTORY)
    if not os.path.isdir(STATE_DIRECTORY) or os.path.islink(STATE_DIRECTORY):
        raise UnsafeStateDirectory(f'{STATE_DIRECTORY} is not a directory')
    if status.st_uid != os.getuid() or status.st_mode & 0o077:
        raise UnsafeStateDirectory(f'{STATE_DIRECTORY} must be owned by uid {os.getuid()} with mode 0700')


# --- platform --------------------------------------------------------------------

if sys.platform == 'darwin':
    libc = ctypes.CDLL(None, use_errno=True)
    libproc = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)
    RUSAGE_INFO_V2 = 2
    PHYS_FOOTPRINT_OFFSET = 16 + 8 * 7  # uuid, then 7 uint64 fields precede phys_footprint
    PROC_PIDTBSDINFO = 3
    PROC_BSDINFO_SIZE = 136
    START_OFFSET = 120  # pbi_start_tvsec, followed by pbi_start_tvusec
    SZOMB = 5

    def sysctl_integer(name, ctype):
        value = ctype()
        size = ctypes.c_size_t(ctypes.sizeof(value))
        if libc.sysctlbyname(name.encode(), ctypes.byref(value), ctypes.byref(size), None, 0) != 0:
            raise OSError(ctypes.get_errno(), f'sysctl {name}')
        return value.value

    def physical_memory():
        return sysctl_integer('hw.memsize', ctypes.c_uint64)

    def available_memory():
        # The percentage memory_pressure(1) reports as "free". macOS keeps it up by
        # compressing other processes, so it trails real allocations; kernel_pressure()
        # covers what it misses.
        return physical_memory() * sysctl_integer('kern.memorystatus_level', ctypes.c_int) // 100

    KERNEL_PRESSURE = {2: 'pause', 4: 'kill'}  # DISPATCH_MEMORYPRESSURE_WARN, _CRITICAL

    def kernel_pressure():
        return KERNEL_PRESSURE.get(sysctl_integer('kern.memorystatus_vm_pressure_level', ctypes.c_int))

    def group_pids(process_group):
        buffer = (ctypes.c_int * 1024)()
        count = libproc.proc_listpgrppids(process_group, buffer, ctypes.sizeof(buffer))
        return [buffer[i] for i in range(max(count, 0)) if buffer[i] > 0]

    def process_memory(pid):
        buffer = ctypes.create_string_buffer(512)
        if libproc.proc_pid_rusage(pid, RUSAGE_INFO_V2, buffer) != 0:
            return 0
        return int.from_bytes(buffer.raw[PHYS_FOOTPRINT_OFFSET:PHYS_FOOTPRINT_OFFSET + 8], 'little')

    def bsd_info(pid):
        buffer = ctypes.create_string_buffer(PROC_BSDINFO_SIZE)
        if libproc.proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, buffer, PROC_BSDINFO_SIZE) <= 0:
            return None
        return buffer.raw

    def zombie(pid):
        # A zombie still accepts kill(pid, 0) but has no BSD info left: ESRCH.
        info = bsd_info(pid)
        if info is None:
            return ctypes.get_errno() == errno.ESRCH
        return int.from_bytes(info[4:8], 'little') == SZOMB

    def start_time(pid):
        info = bsd_info(pid)
        if info is None:
            return None
        seconds = int.from_bytes(info[START_OFFSET:START_OFFSET + 8], 'little')
        microseconds = int.from_bytes(info[START_OFFSET + 8:START_OFFSET + 16], 'little')
        return seconds * 1_000_000 + microseconds
else:
    PAGE_SIZE = os.sysconf('SC_PAGE_SIZE')

    def read_text(path):
        with open(path) as file:
            return file.read().strip()

    def cgroup_directories():
        """The cgroup v2 directories this process sits in, innermost first."""
        try:
            relative = next(line[3:] for line in read_text('/proc/self/cgroup').splitlines()
                            if line.startswith('0::'))
        except (OSError, StopIteration):
            return []
        directories = []
        while True:
            directories.append(os.path.join('/sys/fs/cgroup', relative.lstrip('/')))
            if relative in ('', '/'):
                return directories
            relative = os.path.dirname(relative)

    def cgroup_limits():
        """(limit, current) for every enclosing cgroup with a memory limit."""
        limits = []
        for directory in cgroup_directories():
            try:
                limit = read_text(os.path.join(directory, 'memory.max'))
                if limit != 'max':
                    limits.append((int(limit), int(read_text(os.path.join(directory, 'memory.current')))))
            except (OSError, ValueError):
                pass
        return limits

    def physical_memory():
        total = os.sysconf('SC_PHYS_PAGES') * PAGE_SIZE
        return min([total] + [limit for limit, _ in cgroup_limits()])

    def kernel_pressure():
        return None

    def available_memory():
        available = None
        for line in read_text('/proc/meminfo').splitlines():
            if line.startswith('MemAvailable:'):
                available = int(line.split()[1]) * 1024
        return min([available] + [limit - current for limit, current in cgroup_limits()])

    def descendants(pid):
        pids, pending = [], [pid]
        while pending:
            current = pending.pop()
            pids.append(current)
            try:
                for task in os.listdir(f'/proc/{current}/task'):
                    with open(f'/proc/{current}/task/{task}/children') as children:
                        pending.extend(int(child) for child in children.read().split())
            except OSError:
                pass
        return pids

    def group_pids(process_group):
        if os.path.exists(f'/proc/{process_group}/task/{process_group}/children'):
            return descendants(process_group)
        pids = []
        for entry in os.listdir('/proc'):
            if not entry.isdigit():
                continue
            try:
                with open(f'/proc/{entry}/stat') as stat:
                    fields = stat.read().rsplit(')', 1)[1].split()
                if int(fields[2]) == process_group:
                    pids.append(int(entry))
            except (OSError, IndexError, ValueError):
                pass
        return pids

    def process_memory(pid):
        try:
            with open(f'/proc/{pid}/statm') as statm:
                return int(statm.read().split()[1]) * PAGE_SIZE
        except (OSError, IndexError, ValueError):
            return 0

    def stat_fields(pid):
        try:
            with open(f'/proc/{pid}/stat') as stat:
                return stat.read().rsplit(')', 1)[1].split()
        except (OSError, IndexError):
            return None

    def zombie(pid):
        fields = stat_fields(pid)
        return fields is not None and fields[0] == 'Z'

    def start_time(pid):
        fields = stat_fields(pid)
        return int(fields[19]) if fields else None


if os.environ.get('RAMSCHED_TEST_AVAILABLE'):
    # Tests drive available memory and kernel pressure from files instead of the machine.
    def available_memory():
        with open(os.environ['RAMSCHED_TEST_AVAILABLE']) as file:
            return int(float(file.read()) * GB)

    def kernel_pressure():
        try:
            with open(os.environ['RAMSCHED_TEST_AVAILABLE'] + '.pressure') as file:
                return file.read().strip() or None
        except FileNotFoundError:
            return None


def group_memory(process_group):
    return sum(process_memory(pid) for pid in group_pids(process_group))


def alive(pid, expected_start):
    """Whether pid is still the process that was recorded, not a reuse of its number."""
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    if zombie(pid):
        return False
    return expected_start is None or start_time(pid) == expected_start


def signal_group(process_group, number):
    try:
        os.killpg(process_group, number)
    except (ProcessLookupError, PermissionError):
        pass


# --- limits ----------------------------------------------------------------------

def size_setting(name, default):
    """A size in GB from the environment; "off" gives None."""
    value = os.environ.get(name, '')
    if value == '':
        return default
    if value == 'off':
        return None
    return int(float(value) * GB)


class Limits:
    def __init__(self):
        total = physical_memory()
        self.budget = size_setting('RAMSCHED_BUDGET', None)
        self.headroom = size_setting('RAMSCHED_HEADROOM', total // 10)
        if self.budget is None and self.headroom is None:
            self.budget = total
        headroom = self.headroom or 0
        self.pause_below = size_setting('RAMSCHED_PAUSE_BELOW', headroom // 2) if self.headroom else None
        if self.headroom and self.pause_below is None:
            self.pause_below = 0
        self.kill_below = size_setting('RAMSCHED_KILL_BELOW', headroom // 4) if self.headroom else None
        self.hysteresis = max(256 * MB, headroom // 10)


# --- shared state ----------------------------------------------------------------

class State:
    """Ledger and history under one exclusive lock."""

    def __enter__(self):
        self.lock_file = open(LOCK_PATH, 'a')
        deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(self.lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    self.lock_file.close()
                    raise LockTimeout()
                time.sleep(0.01)
        self.ledger = read_json(LEDGER_PATH, {})
        self.jobs = self.ledger.setdefault('jobs', {})
        self.ledger_changed = False
        self.history = None
        return self

    def load_history(self):
        if self.history is None:
            self.history = read_json(HISTORY_PATH, {})
        return self.history

    def __exit__(self, *exception):
        try:
            if self.ledger_changed:
                write_json(LEDGER_PATH, self.ledger)
            if self.history is not None:
                write_json(HISTORY_PATH, self.history)
        finally:
            fcntl.flock(self.lock_file, fcntl.LOCK_UN)
            self.lock_file.close()

    def set_job(self, key, **fields):
        self.jobs.setdefault(key, {}).update(fields)
        self.ledger_changed = True

    def remove_job(self, key):
        if self.jobs.pop(key, None) is not None:
            self.ledger_changed = True

    def prune_dead(self):
        for key, job in list(self.jobs.items()):
            if alive(int(key), job.get('launcher_start')):
                continue
            process_group = job.get('process_group')
            if process_group and alive(process_group, job.get('group_start')):
                signal_group(process_group, signal.SIGKILL)
                signal_group(process_group, signal.SIGCONT)
            self.remove_job(key)
            log_event('pruned', key, job.get('object', '?'))

    def holders(self, excluding=None):
        return {key: job for key, job in self.jobs.items()
                if key != excluding and job['state'] in HOLDING}

    def anchor(self):
        """The longest-admitted compile holding memory: never paused or killed for pressure."""
        holders = self.holders()
        return min(holders, key=lambda key: holders[key]['admitted']) if holders else None

    def fits(self, limits, key, wanted, used, available, margin=0):
        """Whether job key may hold wanted bytes, of which it already uses used."""
        others = self.holders(excluding=key)
        if not others:
            return True
        pending = sum(max(0, job['want'] - job['reserved']) for job in others.values()
                      if job['state'] == 'paused')
        waiting = sorted((job['since'], other) for other, job in self.jobs.items()
                         if job['state'] == 'waiting' and other != key)
        if waiting and time.time() - waiting[0][0] > PROTECT_AFTER_SECONDS:
            pending += self.jobs[waiting[0][1]]['reserved']
        if limits.budget is not None:
            if sum(job['reserved'] for job in others.values()) + pending + wanted > limits.budget:
                return False
        if limits.headroom is not None:
            unconsumed = sum(max(0, job['reserved'] - job.get('used', 0)) for job in others.values())
            if available - unconsumed - pending - max(0, wanted - used) < limits.headroom + margin:
                return False
        return True


def read_json(path, default):
    try:
        with open(path) as file:
            return json.load(file)
    except (OSError, ValueError):
        return default


def write_json(path, value):
    temporary = f'{path}.{os.getpid()}'
    with open(temporary, 'w') as file:
        json.dump(value, file)
    os.replace(temporary, path)


def log_event(*fields):
    try:
        with open(EVENTS_PATH, 'a') as file:
            file.write('%.3f\t%s\n' % (time.time(), '\t'.join(str(field) for field in fields)))
    except OSError:
        pass


# --- the launcher ----------------------------------------------------------------

def history_key(object_path, arguments):
    build_directory = os.getcwd()
    parent, name = os.path.split(build_directory)
    prefix = '/'.join((os.path.basename(parent), name))
    if object_path:
        return '/'.join((prefix, os.path.relpath(object_path, build_directory)))
    digest = hashlib.sha256('\0'.join([build_directory] + arguments).encode()).hexdigest()[:16]
    return f'{prefix}/#{digest}'


def output_path(arguments):
    for index, argument in enumerate(arguments[:-1]):
        if argument == '-o':
            return os.path.abspath(arguments[index + 1])
    return None


def language(arguments):
    sources = [a for a in arguments if a.endswith(('.c', '.cpp', '.cc', '.cxx', '.S', '.s'))]
    return 'cpp' if any(s.endswith(('.cpp', '.cc', '.cxx')) for s in sources) else 'c'


def estimate(history, key, arguments):
    peaks = history.get(key, {}).get('peaks') if key else None
    if peaks:
        return int(max(peaks) * MARGIN)
    directory = os.path.dirname(key) if key and '#' not in key else None
    siblings = sorted(max(entry['peaks']) for path, entry in history.items()
                      if directory and path.startswith(directory + '/') and entry.get('peaks'))
    if siblings:
        return int(siblings[len(siblings) // 2] * MARGIN)
    configured = size_setting('RAMSCHED_DEFAULT', None)
    if configured:
        return configured
    return DEFAULT_ESTIMATE[language(arguments)]


class Killed(Exception):
    def __init__(self, reservation):
        self.reservation = reservation


class Launcher:
    def __init__(self, arguments):
        self.arguments = arguments
        self.key = str(os.getpid())
        self.object_path = output_path(arguments)
        self.history_key = history_key(self.object_path, arguments)
        self.name = self.object_path or self.history_key
        self.limits = Limits()
        self.child = None
        self.process_group = None
        self.peak = 0
        self.forwarded_signal = None

    def run(self):
        with State() as state:
            reservation = estimate(state.load_history(), self.history_key, self.arguments)
            state.set_job(self.key, state='waiting', reserved=reservation, want=reservation,
                          used=0, since=time.time(), object=self.name,
                          launcher_start=start_time(os.getpid()))
        while True:
            self.acquire(reservation)
            try:
                return self.run_child(reservation)
            except Killed as killed:
                reservation = killed.reservation
                log_event('requeue', self.key, reservation, self.name)

    def acquire(self, reservation):
        waited = False
        while True:
            available = available_memory()
            with State() as state:
                state.prune_dead()
                if state.fits(self.limits, self.key, reservation, 0, available):
                    state.set_job(self.key, state='running', reserved=reservation, want=reservation,
                                  used=0, admitted=time.time())
                    break
            waited = True
            time.sleep(WAIT_SECONDS)
        log_event('admit', self.key, reservation, 'waited' if waited else 'immediate', self.name)

    def run_child(self, reservation):
        started = time.monotonic()
        paused_seconds = 0.0
        self.child = subprocess.Popen(self.arguments, process_group=0)
        self.process_group = self.child.pid
        with State() as state:
            state.set_job(self.key, process_group=self.process_group, run_seconds=0.0,
                          group_start=start_time(self.process_group))
        reserved = reservation
        paused = None  # (since, reason) while SIGSTOPped
        usage = 0
        published = (0.0, 0)
        while True:
            if self.forwarded_signal is not None:
                signal_group(self.process_group, signal.SIGCONT)
                signal_group(self.process_group, self.forwarded_signal)
                self.forwarded_signal = None
                paused = None
            code = self.child.poll()
            if code is not None:
                self.finish(code, time.monotonic() - started)
                return code
            available = available_memory()
            if paused is None:
                usage = group_memory(self.process_group)
                self.peak = max(self.peak, usage)
                reason = self.pressure(available)
                if reason == 'kill':
                    self.kill(reserved)
                if reason is not None and self.pause_for_pressure():
                    paused = (time.monotonic(), 'pressure')
                    log_event('pause', self.key, usage, reserved, self.name, 'pressure')
                elif usage > reserved:
                    wanted = max(int(usage * MARGIN), reserved + GROW_MINIMUM)
                    if self.grow(wanted, usage, available):
                        log_event('grow', self.key, reserved, wanted, self.name)
                        reserved = wanted
                    else:
                        signal_group(self.process_group, signal.SIGSTOP)
                        paused = (time.monotonic(), 'growth')
                        log_event('pause', self.key, usage, wanted, self.name, 'growth')
                time.sleep(POLL_SECONDS)
            else:
                time.sleep(WAIT_SECONDS)
                since, reason = paused
                if self.pressure(available) == 'kill':
                    self.kill(reserved)
                wanted = reserved if reason == 'pressure' else max(int(self.peak * MARGIN),
                                                                   reserved + GROW_MINIMUM)
                resumed, victim = self.try_resume(wanted, usage, available)
                if resumed:
                    paused_seconds += time.monotonic() - since
                    paused = None
                    reserved = wanted
                    signal_group(self.process_group, signal.SIGCONT)
                    log_event('resume', self.key, reserved, self.name)
                elif victim:
                    self.kill(int(max(self.peak, reserved) * 1.5), deadlock=True)
            run_seconds = time.monotonic() - started - paused_seconds
            if paused is None and (run_seconds - published[0] >= PUBLISH_SECONDS
                                   or abs(usage - published[1]) >= PUBLISH_BYTES):
                with State() as state:
                    if self.key in state.jobs:
                        state.set_job(self.key, run_seconds=run_seconds, used=usage)
                published = (run_seconds, usage)

    def pressure(self, available):
        limits = self.limits
        if limits.headroom is None:
            return None
        kernel = kernel_pressure()
        if limits.kill_below is not None and (available < limits.kill_below or kernel == 'kill'):
            return 'kill'
        if available < limits.pause_below or kernel is not None:
            return 'pause'
        return None

    def pause_for_pressure(self):
        with State() as state:
            if state.anchor() == self.key:
                return False
            state.set_job(self.key, state='paused', paused_at=time.time(), reason='pressure')
        signal_group(self.process_group, signal.SIGSTOP)
        return True

    def grow(self, wanted, usage, available):
        with State() as state:
            state.prune_dead()
            if state.fits(self.limits, self.key, wanted, usage, available):
                state.set_job(self.key, state='running', reserved=wanted, want=wanted, used=usage)
                return True
            state.set_job(self.key, state='paused', want=wanted, paused_at=time.time(), reason='growth')
            return False

    def try_resume(self, wanted, usage, available):
        """(resumed, should this job be killed to break a deadlock)."""
        with State() as state:
            state.prune_dead()
            job = state.jobs[self.key]
            anchor = state.anchor() == self.key
            if (anchor and job.get('reason') == 'pressure') or state.fits(
                    self.limits, self.key, wanted, usage, available, margin=self.limits.hysteresis):
                state.set_job(self.key, state='running', reserved=wanted, want=wanted, reason=None)
                return True, False
            if any(other['state'] == 'running' for other in state.jobs.values()):
                return False, False
            paused = sorted((other.get('run_seconds', 0), key) for key, other in state.jobs.items()
                            if other['state'] == 'paused')
            return False, paused[0][1] == self.key

    def kill(self, reservation, deadlock=False):
        """Kill this compile and requeue it, if it is the one to go. Raises Killed."""
        with State() as state:
            if not deadlock:
                holders = state.holders()
                newest = max(holders, key=lambda key: holders[key]['admitted'])
                if (newest != self.key or state.anchor() == self.key
                        or time.time() - state.ledger.get('last_kill', 0) < KILL_INTERVAL_SECONDS):
                    return
                state.ledger['last_kill'] = time.time()
            state.set_job(self.key, state='waiting', reserved=reservation, want=reservation,
                          used=0, since=time.time(), reason=None)
        signal_group(self.process_group, signal.SIGKILL)
        signal_group(self.process_group, signal.SIGCONT)
        self.child.wait()
        log_event('kill', self.key, self.peak, self.name, 'deadlock' if deadlock else 'pressure')
        raise Killed(reservation)

    def finish(self, code, seconds):
        with State() as state:
            state.remove_job(self.key)
            if code == 0 and self.history_key:
                entry = state.load_history().setdefault(self.history_key, {'peaks': []})
                entry['peaks'] = (entry['peaks'] + [self.peak])[-HISTORY_DEPTH:]
        log_event('finish', self.key, self.peak, '%.1f' % seconds, code, self.name)

    def handle_signal(self, number, frame):
        if self.child is None or self.child.returncode is not None:
            self.release()
            os._exit(128 + number)
        self.forwarded_signal = number

    def release(self):
        try:
            with State() as state:
                state.remove_job(self.key)
        except Exception:
            pass


def report():
    events = []
    try:
        with open(EVENTS_PATH) as file:
            events = [line.rstrip('\n').split('\t') for line in file]
    except OSError:
        pass
    counts = {}
    for event in events:
        name = event[1] + (f' ({event[-1]})' if event[1] in ('pause', 'kill') else '')
        counts[name] = counts.get(name, 0) + 1
    print('events:', ', '.join(f'{name} {count}' for name, count in sorted(counts.items())))
    finishes = sorted((int(e[3]), float(e[4]), e[6]) for e in events if e[1] == 'finish')
    for peak, seconds, path in finishes[-15:][::-1]:
        print(f'{peak / GB:6.2f} GB {seconds:7.1f} s  {path}')


def main():
    arguments = sys.argv[1:]
    if arguments == ['--report']:
        report()
        return 0
    if not arguments:
        print(__doc__, file=sys.stderr)
        return 2
    if os.environ.get('RAMSCHED') == 'off' or sys.version_info < (3, 11):
        os.execvp(arguments[0], arguments)
    launcher = None
    try:
        prepare_state_directory()
        os.makedirs(os.path.dirname(HISTORY_PATH), exist_ok=True)
        launcher = Launcher(arguments)
        for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(number, launcher.handle_signal)
        code = launcher.run()
        return 128 - code if code < 0 else code
    except Exception as error:
        try:
            log_event('fail-open', repr(error), ' '.join(arguments))
        except Exception:
            pass
        if launcher is not None:
            launcher.release()
            if launcher.child is not None:
                return launcher.child.wait()
        os.execvp(arguments[0], arguments)


if __name__ == '__main__':
    sys.exit(main())
